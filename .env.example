# =============================================================================
# TinySteps - Environment Variables
# =============================================================================
# SETUP: Copy this file to .env and fill in the values
# NEVER commit .env to GitHub - only .env.example
#
# Ask the project lead (Subhu) for the actual credentials.
# =============================================================================

# Supabase - get from: https://app.supabase.com ? Project Settings ? API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# OneSignal - get from: https://app.onesignal.com ? App ? Keys & IDs
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# OneSignal REST API Key - ONLY needed for Edge Functions (not the Flutter app)
# Already set as Supabase secret - leave this blank unless you are deploying Edge Functions
ONESIGNAL_REST_API_KEY=
